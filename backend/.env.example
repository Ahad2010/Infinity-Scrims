# Infinity Scrims — Environment Variables
# Copy this file to ".env" and fill in real values. NEVER commit .env to git.

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_NAME=infinity_scrims
DB_USER=root
DB_PASS=

# ---------- App ----------
APP_NAME="Infinity Scrims"
BASE_URL=http://localhost/infinity-scrims
APP_DEBUG=true

# ---------- AI Support / Result Detection (Groq) ----------
# Get your key at https://console.groq.com/keys
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WHATSAPP_NUMBER=923000000000

# ---------- Resend (email — verification codes) ----------
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Infinity Scrims <onboarding@resend.dev>

# ---------- JWT (auth) ----------
# Long random string — required for real deployments, generate with e.g. openssl rand -hex 32
JWT_SECRET=

# ---------- CORS ----------
# Not needed when User/Owner and backend are on the same Vercel domain
# (that's how vercel.json here routes them). Set only if you split domains.
CORS_ORIGIN=

# ---------- Cron (optional) ----------
# If set, Vercel Cron sends it as "Authorization: Bearer <value>" automatically.
CRON_SECRET=
